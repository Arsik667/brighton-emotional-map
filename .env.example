# Скопируй в .env и заполни:  cp .env.example .env
# .env лежит в .gitignore — в git он НЕ попадёт.

# --- Reddit (нужен на Этапе 3) ---
# Получить: https://www.reddit.com/prefs/apps -> "create another app" -> тип "script"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# User-Agent обязателен по правилам Reddit API. Формат: platform:appname:version (by /u/username)
REDDIT_USER_AGENT=macos:brighton-emotional-map:v0.1 (by /u/your_reddit_username)

# --- Google Places (ОПЦИОНАЛЬНО, требует биллинга) ---
# Мы его не используем по умолчанию: OSM бесплатен и его данные можно публиковать.
GOOGLE_PLACES_API_KEY=

# Контакт для User-Agent запросов к OpenStreetMap (этого требуют их правила)
OSM_CONTACT_EMAIL=your@email.com
